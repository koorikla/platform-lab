# NOT synced (wrong extension on purpose). Kargo needs push access to the repo. Apply by hand or wire through ESO:
apiVersion: v1
kind: Secret
metadata:
  name: git-platform-lab
  namespace: podinfo
  labels:
    kargo.akuity.io/cred-type: git
stringData:
  repoURL: https://github.com/koorikla/platform-lab.git
  username: <github-user>
  password: <fine-grained PAT, contents:write>
